# Supabase PostgreSQL Connection Configuration (Template)
# Copy this file to .env or create application-local.properties in this directory.

SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=your-database-password